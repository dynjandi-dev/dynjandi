{
  "name": "@dynjandi/cli",
  "version": "0.0.0",
  "description": "The Dynjandi command line. Not yet published; `dynjandi dev` is unfinished.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynjandi-dev/dynjandi.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/dynjandi-dev/dynjandi/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/dynjandi-dev/dynjandi/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "dynjandi": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "pnpm run build && cp ../../LICENSE LICENSE",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@dynjandi/sdk": "workspace:*",
    "@types/node": "22.20.4"
  },
  "dependencies": {
    "@dynjandi/transform-grammar": "0.3.0",
    "@northguild/gmt": "^1.21.0"
  }
}
