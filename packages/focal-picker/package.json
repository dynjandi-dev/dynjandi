{
  "name": "@dynjandi/focal-picker",
  "version": "0.0.0",
  "description": "A focal point picker for images uploaded to Dynjandi, an image CDN. Not yet published.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynjandi-dev/dynjandi.git",
    "directory": "packages/focal-picker"
  },
  "homepage": "https://github.com/dynjandi-dev/dynjandi/tree/main/packages/focal-picker#readme",
  "bugs": {
    "url": "https://github.com/dynjandi-dev/dynjandi/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/react.js"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "capture:crops": "node scripts/capture-crops.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "pnpm run build && cp ../../LICENSE LICENSE",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@dynjandi/sdk": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest-browser-react": "2.3.0"
  }
}
